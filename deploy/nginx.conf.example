# 66th 商家参展申请采集服务 —— Nginx 反代示例
#
# 用法：
#   1. 全局替换 signup.example.com 为你的域名
#   2. 证书路径按实际改（宝塔是 /www/server/panel/vhost/cert/<域名>/）
#   3. 放到 /etc/nginx/conf.d/ 或 /www/server/panel/vhost/nginx/ 下
#   4. nginx -t && nginx -s reload

upstream verifly_signup {
    server 127.0.0.1:8000;
    keepalive 32;
}

# 可选：Nginx 层限流（应用自带 20 次/分钟，这里再加一道保险）
# limit_req_zone $binary_remote_addr zone=signup:10m rate=30r/m;

server {
    listen 80;
    server_name signup.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name signup.example.com;

    # ---- 证书 ----
    ssl_certificate     /www/server/panel/vhost/cert/signup.example.com/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/signup.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # ---- 上传大小：必须 >= MAX_FILE_MB（默认 20MB），否则报 413 ----
    client_max_body_size 30m;
    client_body_buffer_size 1m;
    client_body_timeout 300s;

    access_log /www/wwwlogs/signup.example.com.log;
    error_log  /www/wwwlogs/signup.example.com.error.log warn;

    location / {
        proxy_pass http://verifly_signup;
        proxy_http_version 1.1;

        # 三个头缺一不可：Host 影响生成链接，X-Forwarded-* 影响限流和日志取真实 IP
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        proxy_connect_timeout 10s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;

        # 不缓存接口响应
        proxy_buffering off;
    }

    # 可选：加限流
    # location /api/ {
    #     limit_req zone=signup burst=20 nodelay;
    #     proxy_pass http://verifly_signup;
    #     include /etc/nginx/proxy_params;
    # }

    # 可选：只允许内网访问接口文档
    # location ~ ^/(docs|openapi.json) {
    #     allow 10.0.0.0/8;
    #     allow 172.16.0.0/12;
    #     allow 192.168.0.0/16;
    #     deny all;
    #     proxy_pass http://verifly_signup;
    # }

    location = /favicon.ico {
        access_log off;
        return 204;
    }
}
