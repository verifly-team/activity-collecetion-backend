# ============================================================================
# 66th 商家参展申请采集服务 —— 配置文件模板
# 用法：cp .env.example .env  然后把下面几项改成实际值
# ============================================================================

# ---------------------------------------------------------------------------
# 1. 数据库（必填）
# ---------------------------------------------------------------------------
# 格式：mysql://用户名:密码@主机:端口/库名?charset=utf8mb4
# 同机部署填 127.0.0.1，跨机填内网 IP
# 密码含特殊字符要 URL 编码：@ → %40   : → %3A   / → %2F   # → %23
DATABASE_URL=mysql://verifly:CHANGE_ME@127.0.0.1:3306/verifly_signup?charset=utf8mb4

# 本地开发不想装 MySQL 时改用这行：
# DATABASE_URL=sqlite:///data/app.db

# ---------------------------------------------------------------------------
# 2. 附件存储（必填）
# ---------------------------------------------------------------------------
# 容器内路径，启动时挂卷到宿主机：-v /verifly/activity/uploads:/data/uploads
UPLOAD_DIR=/data/uploads

# 单文件上限（MB）。商家一般传一个 zip，20 够用
MAX_FILE_MB=20
# 每份报名的附件个数与合计大小上限（MB）
MAX_FILES=10
MAX_TOTAL_MB=100
# 允许的扩展名，逗号分隔
ALLOWED_EXT=jpg,jpeg,png,webp,heic,pdf,zip

# ---------------------------------------------------------------------------
# 3. 服务（按需）
# ---------------------------------------------------------------------------
# 允许跨域的来源。同域部署填 *；前端独立域名时填 https://xxx.com
ALLOWED_ORIGINS=*
# 同 IP 每分钟请求上限，0 = 不限流
RATE_LIMIT_PER_MINUTE=20
# 写入库里的隐私政策版本号，政策更新时改这里
PRIVACY_VERSION=v1.0

# ---------------------------------------------------------------------------
# 4. 时区
# ---------------------------------------------------------------------------
TZ=Asia/Shanghai
