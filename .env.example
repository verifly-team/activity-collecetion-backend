# ============ 数据库 ============
# 线上（MySQL）：
DATABASE_URL=mysql://verifly:CHANGE_ME@127.0.0.1:3306/verifly_signup?charset=utf8mb4
# 本地开发（不想装 MySQL 就用这个）：
# DATABASE_URL=sqlite:///data/app.db

# ============ 附件 ============
UPLOAD_DIR=/data/uploads
MAX_FILE_MB=20          # 单个文件上限
MAX_FILES=10            # 每份报名附件个数
MAX_TOTAL_MB=100        # 每份报名附件合计
ALLOWED_EXT=jpg,jpeg,png,webp,heic,pdf,zip

# ============ 其它 ============
ALLOWED_ORIGINS=*
RATE_LIMIT_PER_MINUTE=20
PRIVACY_VERSION=v1.0
